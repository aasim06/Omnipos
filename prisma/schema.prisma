generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id           String          @id @default(cuid())
  module       String          // "fastfood" | "minimart"
  name         String
  description  String?
  costPrice    Float?
  price        Float
  category     String
  skuCode      String?
  rackLocation String?
  unit         String?
  minThreshold Float?          // low-stock alert limit; 0 = alert off, null = store default
  openingStock Float?          // current stock in the base (retail) unit; decimals allowed (KG, L)
  prepTime     Int?
  displayOrder Int?            @default(0)
  tags         String?         // JSON string array
  allergens    String?         // JSON string array
  isAvailable  Boolean         @default(true)
  archivedAt   DateTime?       // removed item with history: hidden, its sales and ledger kept
  imageBase64  String?
  imageUrl     String?
  variants     String?         // JSON string of ProductVariant[]
  batchNumber  String?
  expiryDate   String?         // ISO date (yyyy-mm-dd)
  recipe       String?         // JSON RecipeLine[]: ingredients consumed per unit sold
  itemRole     String?         // "food_menu" | "retail_product" | "raw_ingredient"
  barcode      String?
  primaryUnit  String?         // wholesale unit, e.g. "Carton"
  secondaryUnit String?        // retail / base unit, e.g. "Piece"
  conversionRate Float?        // base units per wholesale unit, e.g. 24
  secondaryPrice Float?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  orderItems   OrderItem[]
}

model Category {
  id        String   @id @default(cuid())
  module    String   // "fastfood" | "minimart"
  name         String
  color        String?  // POS tile colour key ("" = automatic)
  icon         String?  // POS tile icon key ("" = automatic)
  displayOrder Int?     @default(0)
  createdAt    DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  module          String      // "fastfood" | "minimart"
  discountPercent Float       @default(0)
  customerName    String?
  customerId      String?     // CustomerKhata id of the customer this sale belongs to
  orderType       String?     // "dine-in" | "takeaway" | "delivery"
  paymentMode     String?     // "cash" | "card" | "online" | "khata" | "split"
  customerPhone   String?
  splitPayments   String?     // JSON { cash, card, online, khata } for split bills
  stage           String      @default("paid") // "cart" | "kot" | "billed" | "paid"
  totalAmount     Float       @default(0)
  refundedAmount  Float       @default(0)
  syncStatus      String      @default("synced") // "pending" | "synced" | "failed"
  isSynced        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lines           OrderItem[]
  refunds         OrderRefund[]
  kitchenTicket   KitchenTicket?
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String
  unitPrice    Float
  quantity     Float    // decimals for weight / volume sales
  variantLabel String?
  selectedUnit String?  // 'primary' when sold in the wholesale unit (e.g. Carton)
  notes        String?
}

model KitchenTicket {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // "pending" | "cooking" | "ready" | "served"
  orderType   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomerKhata {
  id           String             @id @default(cuid())
  name         String
  phone        String?
  address      String?
  cnic         String?
  customerType String?            @default("retail") // "retail" | "wholesale"
  dueDays      Int?               @default(30)
  currentDebt  Float              @default(0) // Kitna udhaar baki hai (negative = advance)
  creditLimit  Float?             @default(50000)
  note         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  entries      KhataTransaction[]
}

model KhataTransaction {
  id           String        @id @default(cuid())
  khataId      String
  khata        CustomerKhata @relation(fields: [khataId], references: [id], onDelete: Cascade)
  type         String        // "DEBIT" (udhaar diya) | "CREDIT" (wasool kiya)
  amount       Float
  balanceAfter Float
  description  String?
  paymentMethod String?
  reversalOf   String?       // id of the entry this one cancels (ledger correction)
  orderId      String?
  date         DateTime      @default(now())
}

model StockMovement {
  id          String   @id @default(cuid())
  vendorId    String?  // supplier whose payable this receipt was posted to
  module      String   // "fastfood" | "minimart"
  productId   String
  productName String
  type        String   // "in" | "out"
  quantity    Float    // base units; decimals allowed
  unitCost    Float?
  unitPrice   Float?
  reason           String?
  note             String?
  vendorName       String?
  referenceInvoice String?
  batchNumber      String?
  expiryDate       String?
  createdBy        String?  // user who recorded the entry
  reversalOf       String?  // id of the entry this one reverses
  reversedAt       DateTime? // set on an entry that has been reversed
  reversedBy       String?
  correctionOf     String?  // set on a corrected entry: the id it replaces
  variantAllocations String? // JSON { "S": 2, "M": 3 }: size/variant split of the quantity
  date             DateTime @default(now())
}

/// Low-stock alert: at most one active (open / dismissed) alert per product.
model StockAlert {
  id           String    @id @default(cuid())
  productId    String
  productName  String
  level        String    // "low" | "out"
  stockAtAlert Float
  limitAtAlert Float?
  status       String    @default("open") // "open" | "dismissed" | "resolved"
  readAt       DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
}

/// Stock received under one batch / expiry; consumed first-expiry-first-out (FEFO).
model StockBatch {
  id          String    @id @default(cuid())
  productId   String
  movementId  String    @unique // the stock-in entry that created the batch
  batchNumber String?
  expiryDate  String?   // yyyy-mm-dd
  quantity    Float     // received (base units)
  remaining   Float     // still on hand
  unitCost    Float?
  receivedAt  DateTime  @default(now())
}

/// Which batch an out-movement drew from, so reversals and returns restore the same batch.
model BatchAllocation {
  id         String   @id @default(cuid())
  movementId String
  batchId    String
  quantity   Float
  createdAt  DateTime @default(now())
}

model Vendor {
  id             String   @id @default(cuid())
  name           String
  companyName    String?
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  category       String?
  notes          String?
  openingBalance Float    @default(0) // balance owed when the vendor was added
  currentBalance Float    @default(0) // running payable = opening + bills - payments ± adjustments
  archivedAt     DateTime? // hidden from lists; the ledger is kept (suppliers with history are never deleted)
  creditDays     Int       @default(30) // days we have to pay their bills (payables aging / overdue)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   VendorTransaction[]
}

model VendorTransaction {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type          String   // "BILL" | "PAYMENT" | "ADJUSTMENT" (signed)
  amount        Float
  balanceAfter  Float
  description   String?
  billId        String?
  paymentMethod String?
  createdBy     String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
}

model PurchaseBill {
  id            String   @id @default(cuid())
  billNumber    String   @unique
  vendorId      String?
  vendorName    String
  vendorPhone   String?
  billDate      String
  lines         String   // JSON string of PurchaseBillLine[]
  subtotal      Float    @default(0)
  discountAmount Float   @default(0)
  taxAmount     Float    @default(0)
  freightAmount Float    @default(0) // freight / other charges on the delivery (part of landed cost)
  grandTotal    Float    @default(0)
  paidAmount    Float    @default(0)
  paymentMode   String   @default("cash")
  paymentStatus String   @default("unpaid")
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SyncOutbox {
  id          String   @id @default(cuid())
  entityType  String   // "ORDER" | "KHATA_TRANSACTION" | "STOCK_MOVEMENT"
  entityId    String
  action      String   // "CREATE" | "UPDATE" | "DELETE"
  payload     String   // JSON string
  status      String   @default("pending") // "pending" | "processing" | "synced" | "failed"
  retryCount  Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  syncedAt    DateTime?
}

model Expense {
  id          String   @id @default(cuid())
  category    String   // "Rent" | "Utilities" | "Salaries" | "Vendor" | "Petty Cash" | "Maintenance" | "Other"
  amount      Float
  paymentMode String   @default("cash") // "cash" | "bank" | "card"
  description String?
  vendorName  String?
  receiptNo   String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model CashDrawer {
  id          String    @id @default(cuid())
  date        DateTime  @default(now())
  openingFloat Float    @default(0)
  cashSales    Float    @default(0)
  cashIn       Float    @default(0)
  cashOut      Float    @default(0)
  closingCash  Float?
  status       String   @default("open") // "open" | "closed"
  closedAt     DateTime?
  notes        String?
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model OrderRefund {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerName String?
  creditNoteNo String?  // CN-<year>-<seq>, printed on the credit note
  refundAmount Float
  paymentMode  String   @default("cash") // "cash" | "khata" | "card"
  reason       String?
  items        String   // JSON string of returned items
  createdAt    DateTime @default(now())
}


model Quotation {
  id               String    @id
  quoteNumber      String
  module           String    @default("minimart")
  customerName     String
  customerPhone    String?
  customerAddress  String?
  lines            String    // JSON array of cart lines
  subtotal         Float     @default(0)
  discountPercent  Float     @default(0)
  discountAmount   Float     @default(0)
  taxAmount        Float?
  totalAmount      Float     @default(0)
  validUntil       DateTime
  notes            String?
  terms            String?
  status           String    @default("draft") // "draft" | "sent" | "converted" | "expired"
  convertedOrderId String?
  convertedAt      DateTime?
  revisionOf       String?   // quotation this one revises
  advanceAmount    Float     @default(0) // advance taken against this quote (held on the customer's khata)
  advanceKhataId   String?
  sales            String?   // JSON: POS sales of this quote [{ orderId, at, lines: [{ lineIndex, qty }] }]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
