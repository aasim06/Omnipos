{
  "name": "omnipos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron-vite dev",
    "build:web": "vite build",
    "build": "npm run prisma:generate && electron-vite build",
    "prisma:generate": "prisma generate",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "npm run prisma:generate && npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.omnipos.app",
    "productName": "Omnipos",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client"
      },
      {
        "from": "node_modules/.prisma/client",
        "to": "node_modules/.prisma/client"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Omnipos-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Omnipos"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.339",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "cors": "^2.8.6",
    "dexie": "^4.4.5",
    "express": "^5.2.1",
    "lucide-react": "^1.34.0",
    "node-machine-id": "^1.1.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "prisma": "^6.19.3",
    "typescript": "^5",
    "vite": "^6.2.0"
  }
}
